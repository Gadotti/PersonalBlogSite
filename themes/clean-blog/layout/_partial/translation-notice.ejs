<% if (page.translated_by === 'ai-reviewed') { %>
    <% var original = i18n_alternate(); %>
    <div class="alert alert-info" role="note">
        <%= __('translated_ai_reviewed') %>
        <% if (original.exact) { %>
            <a href="<%- url_for('/' + original.path) %>" hreflang="<%= original.lang %>"><%= __('read_original') %></a>
        <% } %>
    </div>
<% } %>
